PORT=5000
NODE_ENV=development
# Leave MONGODB_URI empty to automatically run the built-in zero-config MongoDB Memory Server!
MONGODB_URI=
JWT_SECRET=gourish_quantum_super_secure_jwt_secret_key_2026
CLIENT_URL=http://localhost:5173

# Optional Email Service Config (Defaults to simulated console & in-app delivery)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFICATION_SENDER=notifications@gourish-logistics.com

# Optional SMS / Webhook Mocking
SMS_PROVIDER=mock
